generator client {
  provider = "prisma-client"
  output   = "../src/lib/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// Better-Auth Models
// ----------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isAdmin       Boolean  @default(false)

  sessions Session[]
  accounts Account[]

  // App-specific relations
  homeOrgId       String?
  homeOrg         Organization?      @relation("HomeOrg", fields: [homeOrgId], references: [id])
  memberships     OrgMembership[]
  transactions    AssetTransaction[]
  crewAssignments ProductionCrew[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id String @id @default(cuid())

  // better-auth 1.7 keys accounts by (issuer, accountId) rather than
  // (providerId, accountId). For email/password this is always
  // "local:credential" — see createLocalAccountIssuer in @better-auth/core.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// Backs better-auth's device-authorization plugin (RFC 8628). A warehouse PDA
// can't reasonably prompt for a password, so it shows a short userCode that
// someone approves from a signed-in browser. Field names are dictated by the
// plugin's schema — don't rename them.
model DeviceCode {
  id              String    @id @default(cuid())
  deviceCode      String    @unique
  userCode        String    @unique
  userId          String?
  expiresAt       DateTime
  status          String // pending | approved | denied
  lastPolledAt    DateTime?
  pollingInterval Int?
  clientId        String?
  scope           String?

  @@map("device_code")
}

// ----------------------------------------------------
// App specific models
// ----------------------------------------------------

model Organization {
  id   String @id @default(cuid())
  name String

  // Optional abbreviation shown instead of `name` wherever space is tight
  // (pickers, tables, badges). Legal documents always use `name`.
  shortName String?

  assetIdPrefix String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultAssetVisibility String @default("PUBLIC")

  // Visual identity: always manually set by an org owner/admin (issue #13).
  color       String @unique
  avatarLabel String @unique

  defaultInspectionIntervalMonths Int?
  isKleinunternehmer              Boolean @default(false)

  // Billing details for offer/invoice generation (issue #9 follow-up).
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  taxId     String? // Steuernummer or USt-IdNr

  bankAccountHolder String?
  iban              String?
  bic               String?
  bankName          String?

  homeUsers User[]          @relation("HomeOrg")
  members   OrgMembership[]

  locations       Location[]
  assets          Asset[]
  bundleTemplates BundleTemplate[]
  productions     Production[]
  categoryRates   OrgCategoryRate[]
  offers          Offer[]
  invoices        Invoice[]
  customers       Customer[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model OrgMembership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
}

model Manufacturer {
  id   String @id @default(cuid())
  name String
  // The object key in the S3-compatible store, not an address: see
  // src/lib/images.ts. A stored URL would pin the row to whichever host the
  // store was on when it was uploaded.
  logoPath String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Category {
  id String @id @default(cuid())
  // English is the source name — it's what `name` has always held, what the
  // API returns, and what a billing line snapshots. `nameDe` is the German
  // display name; empty means "no translation yet", and the English name shows
  // through rather than a blank chip.
  name      String   @unique
  nameDe    String?
  color     String   @default("#ffffff")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products        Product[]
  bundleTemplates BundleTemplate[]
  orgRates        OrgCategoryRate[]
}

model Product {
  id             String       @id @default(cuid())
  name           String
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])
  /// Object key, like Manufacturer.logoPath.
  imagePath      String?

  // Pricing (issue #9): the catalog price a rental rate is calculated from.
  // It lives on the product, not on each unit — billing asks "what does this
  // kind of device cost per day", and two identical lamps bought two years
  // apart still rent for the same money. What an individual unit cost is a
  // bookkeeping fact, and Asset.purchaseDate is what remains of it.
  netPurchasePrice Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]
}

model Address {
  id         String  @id @default(cuid())
  line1      String
  line2      String?
  postalCode String
  city       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations     Location[]
  productions   Production[]
  organizations Organization[]
  customers     Customer[]
}

model Location {
  id             String        @id @default(cuid())
  name           String
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addressId      String
  address        Address       @relation(fields: [addressId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  assets         Asset[]
  assetBundles   AssetBundle[]
}

model Asset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  serialNumber String?
  assetTag     String? @unique
  status       String  @default("AVAILABLE") // see src/lib/asset-status.ts

  bundleId String?
  bundle   AssetBundle? @relation(fields: [bundleId], references: [id])

  // An accessory that travels with one specific unit — its case, its power cable, its
  // omega brackets. Still a full asset (DGUV inspection, image, history); only its
  // booking, location and bundle membership follow the parent. One level deep.
  parentAssetId String?
  parent        Asset?  @relation("AssetAccessories", fields: [parentAssetId], references: [id], onDelete: SetNull)
  accessories   Asset[] @relation("AssetAccessories")

  // A generated preview of this unit together with its attached accessories.
  // Product.imagePath remains the shared catalogue photo for the bare product.
  generatedImagePath        String?
  generatedImageFingerprint String?

  // When this individual unit was bought. The price it is billed at lives on
  // the Product — see Product.netPurchasePrice.
  purchaseDate DateTime?

  // DGUV inspection tracking (issue #7). Snapshotted from the org's default
  // at creation, not a live reference — see Organization.defaultInspectionIntervalMonths.
  inspectionIntervalMonths Int?
  nextInspectionDue        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionItems ProductionItem[]
  transactions    AssetTransaction[]
  inspections     Inspection[]

  // The one index this schema declares: every booking, scan and print walks
  // parent → accessories, and Prisma indexes no relation scalar on its own.
  @@index([parentAssetId])
}

// The catalog entry for a kind of bundle (e.g. "Standard Lighting Kit") — like
// Product is to Asset. Org- and category-scoped since bundles are curated kits
// specific to one org, not a shared real-world catalog.
model BundleTemplate {
  id             String       @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])

  instances AssetBundle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A physical instance of a BundleTemplate — like Asset is to Product.
model AssetBundle {
  id         String         @id @default(cuid())
  templateId String
  template   BundleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // Optional, like Asset.assetTag — distinguishes multiple physical instances
  // of the same template.
  tag String? @unique

  locationId      String?
  location        Location?        @relation(fields: [locationId], references: [id])
  assets          Asset[]
  productionItems ProductionItem[]

  // If set, offers/invoices bill this bundle as a single line at this price —
  // the individual assets in the bundle don't each need their own price.
  netPurchasePrice Decimal? @db.Decimal(10, 2)

  // Generated preview of this instance's current contents. The fingerprint
  // makes reads cheap while still letting them repair a stale preview.
  imagePath        String?
  imageFingerprint String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Production {
  id        String    @id @default(cuid())
  name      String
  startDate DateTime?
  endDate   DateTime?

  // Show duration (issue backlog): the subset of the total duration that is
  // actually billable show days, used for offer/invoice day-count. Total
  // duration (startDate/endDate) still governs asset blocking/calendar.
  showStartDate DateTime?
  showEndDate   DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items        ProductionItem[]
  crew         ProductionCrew[]
  transactions AssetTransaction[]
  offers       Offer[]
  invoices     Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reusable, org-scoped customer record — optionally attached to a Production
// so its details can auto-populate offers/invoices. Offer/Invoice keep their
// own snapshot fields (customerName etc.) so issued documents stay fixed even
// if the Customer record is edited later; customerId there is a soft
// reference only, same pattern as OfferItem.assetId.
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyName   String?
  contactPerson String?
  email         String?

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  productions Production[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductionItem {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  sourceBundleId String?
  sourceBundle   AssetBundle? @relation(fields: [sourceBundleId], references: [id])

  status String @default("PENDING") // PENDING, APPROVED, CHECKED_OUT, RETURNED

  @@unique([productionId, assetId])
}

model ProductionCrew {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String?
  createdAt    DateTime   @default(now())

  @@unique([productionId, userId])
}

model AssetTransaction {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  productionId String?
  production   Production? @relation(fields: [productionId], references: [id], onDelete: SetNull)

  action String
  data   Json?

  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// DGUV inspection tracking (issue #7)
// ----------------------------------------------------

model Inspection {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  performedAt   DateTime
  result        String // e.g. "PASSED", "FAILED"
  notes         String?
  inspectorName String? // the certifying inspector is typically external, not an app user
  nextDueDate   DateTime?

  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// Offers & invoices (issues #8, #9)
// ----------------------------------------------------

model OrgCategoryRate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Daily rental rate as a percentage of an asset's net purchase price, e.g. 2.50 = 2.5%/day
  percentage Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, categoryId])
}

model Offer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionId   String?
  production     Production?  @relation(fields: [productionId], references: [id], onDelete: SetNull)

  // Soft reference only (no FK/relation) — see OfferItem.assetId. Lets an
  // offer point back at the Customer it was populated from without pinning
  // the issued document's snapshot fields below to that record.
  customerId            String?
  customerName          String
  customerAddress       String?
  customerContactPerson String?
  customerEmail         String?

  dayCount      Int
  discountType  String? // "PERCENT" | "AMOUNT"
  discountValue Decimal? @db.Decimal(10, 2)

  // Which of the production's booked assets were billed — "ALL" or
  // "OWN_ORG_ONLY" (excludes assets loaned in from partner orgs). Persisted
  // so a later re-sync from the production recomputes the same scope the
  // offer was originally created with.
  assetScope String @default("ALL")

  // Snapshot at creation — 19% German VAT, 0% for Kleinunternehmer orgs
  // (§19 UStG). Kept as its own field rather than derived, so a future VAT
  // rate change in the app doesn't retroactively alter existing documents.
  vatRatePercent Decimal @default(19) @db.Decimal(4, 2)

  items    OfferItem[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfferItem {
  id      String @id @default(cuid())
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  // Soft reference only (no FK/relation): a line must survive the asset it
  // was priced from being edited or deleted later.
  assetId String?
  // Soft reference only — set instead of assetId for bundle-priced lines, so
  // re-syncing from the production can match a bundle line across updates
  // even as its member count/description changes.
  bundleId String?

  // Category snapshot (soft reference, no FK) — grouping/display stays
  // stable even if the category is later renamed or the source asset/bundle
  // is recategorized.
  categoryId     String?
  categoryName   String?
  categoryNameDe String?
  categoryColor  String?

  // Product snapshot (soft reference, no FK) — what lets units of the same
  // product collapse into one "3 × …" line on the document while each unit
  // keeps its own row in the database. productLabel is the description
  // without the per-unit tag, so the collapsed line needs no string surgery.
  productId    String?
  productLabel String?

  description      String
  netPurchasePrice Decimal @db.Decimal(10, 2)
  ratePercent      Decimal @db.Decimal(5, 2)
  dailyRate        Decimal @db.Decimal(10, 2)
  lineTotal        Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
}

// Gapless-not-required-but-never-duplicated sequential invoice numbering
// (§14(4) Nr. 4 UStG) — one counter row per year, incremented in a transaction.
model InvoiceSequence {
  id         String @id @default(cuid())
  year       Int    @unique
  lastNumber Int    @default(0)
}

model Invoice {
  id     String @id @default(cuid())
  number String @unique // e.g. "2026-0007"

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productionId   String?
  production     Production?  @relation(fields: [productionId], references: [id], onDelete: SetNull)
  offerId        String?
  offer          Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)

  // Soft reference only — see OfferItem.assetId / Offer.customerId.
  customerId            String?
  customerName          String
  customerAddress       String?
  customerContactPerson String?
  customerEmail         String?

  issueDate DateTime @default(now())
  dayCount  Int

  discountType  String?
  discountValue Decimal? @db.Decimal(10, 2)

  // Same purpose as Offer.assetScope — lets a pre-send invoice re-sync its
  // items from the production using the original billing scope.
  assetScope String @default("ALL")

  // Null while the invoice is still a draft — items can be corrected and
  // re-synced from the production. Once set, the invoice is immutable
  // (GoBD/§14 UStG): no more item updates, no more field edits.
  sentAt DateTime?

  // Snapshot of the org's Kleinunternehmer status at issuance — GoBD requires
  // the issued document's content to stay fixed even if the org flag changes later.
  isKleinunternehmerSnapshot Boolean @default(false)
  vatRatePercent             Decimal @default(19) @db.Decimal(4, 2)

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Soft reference only — see OfferItem.assetId.
  assetId String?
  // Soft reference only — see OfferItem.bundleId.
  bundleId String?

  // Soft reference only — see OfferItem.categoryId.
  categoryId     String?
  categoryName   String?
  categoryNameDe String?
  categoryColor  String?

  // Soft reference only — see OfferItem.productId.
  productId    String?
  productLabel String?

  description      String
  netPurchasePrice Decimal @db.Decimal(10, 2)
  ratePercent      Decimal @db.Decimal(5, 2)
  dailyRate        Decimal @db.Decimal(10, 2)
  lineTotal        Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
}
